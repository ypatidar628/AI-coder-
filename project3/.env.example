# Google Gemini API Key
# Get your API key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Default Gemini Model (options: gemini-3.5-flash, gemini-3.1-flash-lite, gemini-3.8-flash, gemini-flash-latest)
NEXT_PUBLIC_DEFAULT_GEMINI_MODEL=gemini-3.5-flash
